MATH_API_KEY=
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_MAX_CLIENTS=10000
# Number of trusted reverse proxies in front of the app. Set to 0 for a direct connection.
TRUSTED_PROXY_HOPS=0
MAX_EXPRESSION_LENGTH=300
MAX_SYMBOL_LENGTH=32
CALCULATION_TIMEOUT_SECONDS=10
CALCULATION_WORKERS=4
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_FILE=logs/math-service.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
GENERAL_CHAT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
GENERAL_CHAT_API_KEY=
GENERAL_CHAT_MODEL=qwen-plus
VISION_API_BASE=
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=30
OCR_URL_DIRECT_TIMEOUT_SECONDS=12
OCR_URL_TOTAL_TIMEOUT_SECONDS=55
OCR_URL_COZE_RESERVE_SECONDS=10
COZE_API_BASE=https://api.coze.cn
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_OCR_WORKFLOW_ID=
COZE_OCR_IMAGE_PARAMETER=image
COZE_OCR_IMAGE_PARAMETER_FORMAT=file_id
COZE_OCR_OUTPUT_FIELD=
COZE_OCR_WORKFLOW_BOT_ID=
COZE_TIMEOUT_SECONDS=60
COZE_POLL_INTERVAL_SECONDS=0.8
# Windows: blank/auto enables local OCR when no upstream OCR is configured.
WINDOWS_OCR_FALLBACK=
WINDOWS_OCR_TIMEOUT_SECONDS=30
