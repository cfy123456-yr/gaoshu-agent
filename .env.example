MATH_API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_EXPRESSION_LENGTH=300
MAX_SYMBOL_LENGTH=32
CALCULATION_TIMEOUT_SECONDS=10
CALCULATION_WORKERS=4
LOG_ENABLED=true
LOG_LEVEL=INFO
LOG_FILE=logs/math-service.jsonl
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
GENERAL_CHAT_API_URL=https://api.deepseek.com/chat/completions
GENERAL_CHAT_API_KEY=
GENERAL_CHAT_MODEL=deepseek-chat
# 公网识图主路径：令牌只放在服务器环境变量中，不要提交到仓库。
COZE_API_TOKEN=
COZE_BOT_ID=
COZE_API_BASE=https://api.coze.cn
COZE_TIMEOUT_SECONDS=60
COZE_POLL_INTERVAL_SECONDS=0.8
# Linux 公网环境保持 false；Windows 本机开发可临时改为 true。
WINDOWS_OCR_FALLBACK=false
WINDOWS_OCR_TIMEOUT_SECONDS=30
